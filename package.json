{
	"name": "turnstone",
	"version": "0.2.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"android": "pnpm run prebuild-android && expo run:android",
		"android-rebuild": "expo prebuild --platform android --clean --no-install && pnpm run android",
		"android-release": "TURNSTONE_RELEASE_BUILD=1 pnpm run android --variant release",
		"bundle-check": "expo export --platform android --output-dir .bundle-check",
		"ios": "expo run:ios",
		"lint": "pnpm run lint:prettier && pnpm run lint:eslint && pnpm run lint:json",
		"lint-fix": "pnpm run lint-fix:prettier && pnpm run lint-fix:eslint && pnpm run lint-fix:json",
		"lint-fix:eslint": "eslint ./ --fix",
		"lint-fix:json": "jsonsort -t *.json '!./node_modules' '!./**/.env*'",
		"lint-fix:prettier": "prettier --write '{**/*,*}.{js,ts,jsx,tsx,cjs,cts,mjs,mts,html}'",
		"lint:eslint": "eslint ./ --quiet --no-error-on-unmatched-pattern",
		"lint:json": "pnpm run lint-fix:json -c",
		"lint:prettier": "prettier --check '{**/*,*}.{js,ts,jsx,tsx,cjs,cts,mjs,mts,html}'",
		"prebuild-android": "expo prebuild --platform android --no-install",
		"relay": "node ./scripts/ssh-web-relay.mjs",
		"release:major": "node ./scripts/release.mjs major",
		"release:minor": "node ./scripts/release.mjs minor",
		"release:patch": "node ./scripts/release.mjs patch",
		"reset-project": "node ./scripts/reset-project.js",
		"start": "expo start --dev-client",
		"start-tailscale": "REACT_NATIVE_PACKAGER_HOSTNAME=100.92.106.175 expo start --dev-client",
		"start-usb": "adb reverse tcp:8081 tcp:8081; REACT_NATIVE_PACKAGER_HOSTNAME=localhost expo start --dev-client",
		"test:contract": "vitest --config=./vitest.config.mts",
		"test:smoke": "vitest --config=./vitest.config.smoke.mts",
		"typecheck": "tsc --noEmit",
		"usb-reverse": "adb reverse tcp:8081 tcp:8081",
		"vendor:file-icons": "node ./scripts/vendor-file-icons.mjs",
		"vendor:highlight": "node ./scripts/vendor-highlight.mjs",
		"vendor:mermaid": "node ./scripts/vendor-mermaid.mjs",
		"vendor:pdfjs": "node ./scripts/vendor-pdfjs.mjs",
		"web": "expo start --web"
	},
	"dependencies": {
		"@expo-google-fonts/inter": "^0.4.2",
		"@expo-google-fonts/jetbrains-mono": "^0.4.1",
		"@expo/ui": "~57.0.21",
		"@expo/vector-icons": "^15.1.1",
		"@react-native-async-storage/async-storage": "3.1.1",
		"@react-native/js-polyfills": "0.87.1",
		"@ronradtke/react-native-markdown-display": "^9.0.3",
		"buffer": "^6.0.3",
		"crypto-browserify": "^3.12.1",
		"diff": "^9.0.0",
		"events": "^3.3.0",
		"expo": "~57.0.26",
		"expo-asset": "~57.0.18",
		"expo-clipboard": "~57.0.2",
		"expo-constants": "~57.0.20",
		"expo-dev-client": "~57.0.19",
		"expo-device": "~57.0.2",
		"expo-file-system": "~57.0.7",
		"expo-font": "~57.0.4",
		"expo-glass-effect": "~57.0.4",
		"expo-image": "~57.0.5",
		"expo-linking": "~57.0.11",
		"expo-local-authentication": "~57.0.3",
		"expo-router": "~57.0.24",
		"expo-secure-store": "~57.0.4",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"expo-symbols": "~57.0.3",
		"expo-system-ui": "~57.0.4",
		"expo-web-browser": "~57.0.3",
		"ignore": "^7.0.11",
		"micro-key-producer": "^0.10.2",
		"pako": "^3.0.2",
		"parse-diff": "^0.12.0",
		"process": "^0.11.10",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-native": "0.87.1",
		"react-native-blob-util": "^0.25.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-keyboard-controller": "1.22.6",
		"react-native-mmkv": "^4.3.2",
		"react-native-paper": "5.15.3",
		"react-native-quick-crypto": "^1.1.7",
		"react-native-reanimated": "4.7.0",
		"react-native-render-html": "^6.3.4",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.28.0",
		"react-native-svg": "15.15.5",
		"react-native-tcp-socket": "^6.4.3",
		"react-native-web": "~0.21.3",
		"react-native-webview": "14.0.1",
		"react-native-worklets": "0.13.0",
		"ssh2": "^1.17.0",
		"stream-browserify": "^3.0.0",
		"text-encoding-polyfill": "^0.6.7",
		"util": "^0.12.5",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@beecode/msh-test-contractor": "^1.0.2",
		"@eslint/js": "^10.0.1",
		"@types/react": "~19.3.0",
		"@types/ssh2": "^1.15.6",
		"@types/ws": "^8.18.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-no-loops": "^0.4.0",
		"eslint-plugin-no-only-tests": "^3.4.0",
		"eslint-plugin-no-relative-import-paths": "^1.7.3",
		"eslint-plugin-sort-keys-fix": "^1.1.2",
		"globals": "^17.13.0",
		"highlight.js": "^11.12.0",
		"json-sort-cli": "^4.3.1",
		"material-icon-theme": "^5.38.1",
		"mermaid": "^12.0.0",
		"pdfjs-dist": "6.3.289",
		"prettier": "^3.9.9",
		"tinyrainbow": "^3.2.0",
		"typescript": "~7.0.2",
		"typescript-eslint": "^8.71.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@10.18.1",
	"pnpm": {
		"overrides": {
			"buffer": "^6.0.3"
		},
		"patchedDependencies": {
			"@expo/cli@57.0.27": "patches/@expo__cli@57.0.27.patch",
			"@expo/metro-config@57.0.12": "patches/@expo__metro-config@57.0.12.patch",
			"eslint-plugin-import@2.32.0": "patches/eslint-plugin-import@2.32.0.patch",
			"eslint-plugin-sort-keys-fix@1.1.2": "patches/eslint-plugin-sort-keys-fix@1.1.2.patch",
			"expo-dev-launcher@57.0.20": "patches/expo-dev-launcher@57.0.20.patch",
			"expo-modules-autolinking@57.0.13": "patches/expo-modules-autolinking@57.0.13.patch",
			"expo-modules-core@57.0.20": "patches/expo-modules-core@57.0.20.patch",
			"expo@57.0.26": "patches/expo@57.0.26.patch",
			"react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch",
			"react-native-worklets@0.13.0": "patches/react-native-worklets@0.13.0.patch"
		}
	}
}
